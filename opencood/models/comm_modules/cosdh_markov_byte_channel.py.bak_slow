"""
CoSDH-Markov byte-stream channel baseline.

This module is intentionally minimal. It applies only:
  1) link-level Markov state transition;
  2) bandwidth-limited packet transmission;
  3) Bernoulli packet loss;
  4) state-dependent delay / stale message.

It does NOT add quantization, FEC, redundancy, cache recovery, interpolation,
or any action selection policy.

The channel is designed to be applied after CoSDH/Where2comm has already
selected its communicable message, e.g. after:
    message = feature * communication_mask

Packetization follows byte-stream packetization:
    v = Flatten(raw_float_message_selected_by_mask)
    packet_i = v[(i-1) * Lp : i * Lp]
where Lp is packet_size_bytes / bytes_per_value values.
"""

from __future__ import annotations

import math
from collections import defaultdict, deque
from typing import Any, Dict, List, Optional, Tuple

import torch
import torch.nn as nn
import torch.nn.functional as F


class CosDHMarkovByteChannel(nn.Module):
    """Byte-stream Markov channel for CoSDH selected messages.

    Parameters are provided by cfg, typically under model.args.cosdh_markov.

    Expected input:
        message: [sum_cav, C, H, W]
        record_len: [B]
        communication_mask: optional mask. When available, only selected
            locations are serialized into the byte stream. This preserves
            CoSDH's original efficient communication behavior.
    """

    def __init__(self, cfg: Optional[Dict[str, Any]] = None):
        super().__init__()
        cfg = cfg or {}

        self.enabled = bool(cfg.get("enabled", False))
        self.scope = str(cfg.get("scope", "link"))
        self.impair_ego = bool(cfg.get("impair_ego", False))
        self.verbose = bool(cfg.get("verbose", False))

        self.fps = float(cfg.get("fps", 10.0))
        if self.fps <= 0:
            raise ValueError("cosdh_markov.fps must be positive")
        self.frame_interval_ms = 1000.0 / self.fps

        packet_cfg = cfg.get("packetization", {}) or {}
        self.packet_size_bytes = int(packet_cfg.get("packet_size_bytes", 1024))
        self.bytes_per_value = int(packet_cfg.get("bytes_per_value", 4))
        self.serialization = str(packet_cfg.get("serialization", "raw_float"))
        self.zero_fill_missing = bool(packet_cfg.get("zero_fill_missing", True))

        if self.packet_size_bytes <= 0:
            raise ValueError("packet_size_bytes must be positive")
        if self.bytes_per_value <= 0:
            raise ValueError("bytes_per_value must be positive")
        if self.packet_size_bytes < self.bytes_per_value:
            raise ValueError("packet_size_bytes must be >= bytes_per_value")
        if self.serialization != "raw_float":
            raise ValueError(
                "This baseline intentionally supports only raw_float serialization. "
                "Do not use int8/fp16 quantization here if you want no quantization impact."
            )

        self.values_per_packet = max(1, self.packet_size_bytes // self.bytes_per_value)

        self.states = list(cfg.get("states", ["good", "medium", "bad"]))
        if not self.states:
            raise ValueError("cosdh_markov.states cannot be empty")

        self.initial_state = str(cfg.get("initial_state", cfg.get("init_state", self.states[0])))
        if self.initial_state not in self.states:
            self.initial_state = self.states[0]

        self.transition = self._parse_transition(
            cfg.get("transition_matrix", cfg.get("transition", None))
        )

        default_profiles = {
            "good": {
                "bandwidth_mbps": 27.0,
                "packet_loss_rate": 0.05,
                "delay_ms": 10.0,
                "temporal_source": "current",
            },
            "medium": {
                "bandwidth_mbps": 5.0,
                "packet_loss_rate": 0.20,
                "delay_ms": 50.0,
                "temporal_source": "current",
            },
            "bad": {
                "bandwidth_mbps": 1.0,
                "packet_loss_rate": 0.35,
                "delay_ms": 100.0,
                "temporal_source": "previous_frame",
            },
        }
        user_profiles = cfg.get("state_profiles", cfg.get("state_cfg", {})) or {}
        self.state_profiles: Dict[str, Dict[str, Any]] = {}
        for state in self.states:
            profile = dict(default_profiles.get(state, {}))
            profile.update(user_profiles.get(state, {}))
            self.state_profiles[state] = profile

        self._link_state: Dict[str, int] = {}
        self._delay_cache = defaultdict(lambda: deque(maxlen=256))
        self.last_info: List[Dict[str, Any]] = []

    def _parse_transition(self, matrix: Any) -> torch.Tensor:
        n = len(self.states)
        if matrix is None:
            if self.states == ["good", "medium", "bad"]:
                rows = [
                    [0.85, 0.13, 0.02],
                    [0.10, 0.80, 0.10],
                    [0.03, 0.17, 0.80],
                ]
            else:
                rows = [[1.0 / n for _ in range(n)] for _ in range(n)]
            return torch.tensor(rows, dtype=torch.float32)

        if isinstance(matrix, dict):
            rows = []
            for s_from in self.states:
                row_dict = matrix.get(s_from, {})
                row = [float(row_dict.get(s_to, 0.0)) for s_to in self.states]
                rows.append(row)
            tensor = torch.tensor(rows, dtype=torch.float32)
        else:
            tensor = torch.tensor(matrix, dtype=torch.float32)

        if tensor.shape != (n, n):
            raise ValueError(
                f"transition matrix shape must be {(n, n)}, got {tuple(tensor.shape)}"
            )

        # Normalize each row defensively.
        row_sum = tensor.sum(dim=1, keepdim=True)
        row_sum[row_sum <= 0] = 1.0
        tensor = tensor / row_sum
        return tensor

    def _state_to_idx(self, state: str) -> int:
        return self.states.index(state)

    def _next_state(self, link_key: str, device: torch.device) -> str:
        if link_key not in self._link_state:
            self._link_state[link_key] = self._state_to_idx(self.initial_state)

        cur_idx = self._link_state[link_key]
        prob = self.transition[cur_idx].to(device)
        next_idx = int(torch.multinomial(prob, num_samples=1).item())
        self._link_state[link_key] = next_idx
        return self.states[next_idx]

    def _normalize_comm_mask(
        self,
        communication_mask: Optional[torch.Tensor],
        global_idx: int,
        target_hw: Tuple[int, int],
        device: torch.device,
    ) -> Optional[torch.Tensor]:
        """Return a [1, 1, H, W] boolean-like selected mask if possible."""
        if communication_mask is None or not torch.is_tensor(communication_mask):
            return None

        mask = communication_mask
        try:
            # Common case: [N, 1, H, W] or [N, H, W].
            if mask.dim() == 4 and mask.shape[0] > global_idx:
                one = mask[global_idx:global_idx + 1]
            elif mask.dim() == 3 and mask.shape[0] > global_idx:
                one = mask[global_idx:global_idx + 1].unsqueeze(1)
            else:
                return None

            if one.dim() != 4:
                return None
            if one.shape[1] != 1:
                one = one.mean(dim=1, keepdim=True)
            one = one.to(device=device, dtype=torch.float32)
            if one.shape[-2:] != target_hw:
                one = F.interpolate(one, size=target_hw, mode="nearest")
            return (one > 0).float()
        except Exception:
            return None

    def _selected_flatten(
        self,
        feat: torch.Tensor,
        selected_spatial_mask: Optional[torch.Tensor],
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        """Flatten only CoSDH-selected values.

        Args:
            feat: [1, C, H, W]
            selected_spatial_mask: [1, 1, H, W], optional.

        Returns:
            selected_values: [M]
            value_mask: [C, H, W] bool mask for scattering selected_values back.
        """
        _, C, H, W = feat.shape
        if selected_spatial_mask is None:
            value_mask = torch.ones((C, H, W), device=feat.device, dtype=torch.bool)
        else:
            value_mask = selected_spatial_mask[0].bool().expand(C, H, W)

        selected_values = feat[0][value_mask]
        return selected_values, value_mask

    def _get_delayed_message(
        self,
        link_key: str,
        current_feat: torch.Tensor,
        current_mask: Optional[torch.Tensor],
        profile: Dict[str, Any],
    ) -> Tuple[torch.Tensor, Optional[torch.Tensor], int]:
        """Return current or stale message according to state delay policy."""
        cache = self._delay_cache[link_key]
        cached_mask = current_mask.detach().clone() if current_mask is not None else None
        cache.append((current_feat.detach().clone(), cached_mask))

        temporal_source = str(profile.get("temporal_source", "auto"))
        delay_ms = float(profile.get("delay_ms", 0.0))

        if temporal_source == "current":
            delay_slots = 0
        elif temporal_source in {"previous", "previous_frame", "stale"}:
            delay_slots = max(1, int(round(delay_ms / self.frame_interval_ms)))
        else:
            delay_slots = int(round(delay_ms / self.frame_interval_ms))

        if delay_slots <= 0:
            return current_feat, current_mask, 0

        target_idx = len(cache) - 1 - delay_slots
        if target_idx >= 0:
            feat, mask = cache[target_idx]
            return feat.to(current_feat.device), (
                mask.to(current_feat.device) if mask is not None else None
            ), delay_slots

        # No history available: stale message unavailable -> zero.
        zero_feat = torch.zeros_like(current_feat)
        zero_mask = torch.zeros_like(current_mask) if current_mask is not None else current_mask
        return zero_feat, zero_mask, delay_slots

    def _apply_packet_budget_and_loss(
        self,
        feat: torch.Tensor,
        selected_spatial_mask: Optional[torch.Tensor],
        bandwidth_mbps: float,
        packet_loss_rate: float,
    ) -> Tuple[torch.Tensor, Dict[str, Any]]:
        """Serialize selected raw-float values and apply packet-level impairment."""
        selected_values, value_mask = self._selected_flatten(feat, selected_spatial_mask)
        num_values = int(selected_values.numel())

        if num_values == 0:
            return torch.zeros_like(feat), {
                "selected_values": 0,
                "message_bytes": 0,
                "total_packets": 0,
                "budget_packets": 0,
                "sent_packets": 0,
                "received_packets": 0,
            }

        total_packets = int(math.ceil(num_values / float(self.values_per_packet)))
        message_bytes = int(num_values * self.bytes_per_value)

        budget_bytes = float(bandwidth_mbps) * 1e6 / 8.0 / self.fps
        budget_packets = int(math.floor(budget_bytes / float(self.packet_size_bytes)))
        budget_packets = max(0, budget_packets)
        sent_packets = min(total_packets, budget_packets)

        keep_values = torch.zeros(num_values, device=feat.device, dtype=torch.bool)

        received_packets = 0
        if sent_packets > 0:
            # Baseline packet ordering: sequential byte-stream packets, no score ranking.
            receive = torch.rand(sent_packets, device=feat.device) > float(packet_loss_rate)
            for packet_idx in range(sent_packets):
                if bool(receive[packet_idx].item()):
                    start = packet_idx * self.values_per_packet
                    end = min(num_values, (packet_idx + 1) * self.values_per_packet)
                    keep_values[start:end] = True
                    received_packets += 1

        impaired_selected = torch.zeros_like(selected_values)
        if self.zero_fill_missing:
            impaired_selected[keep_values] = selected_values[keep_values]
        else:
            # For completeness; official baseline should keep zero_fill_missing=True.
            impaired_selected = selected_values.clone()

        impaired_feat = torch.zeros_like(feat)
        impaired_feat[0][value_mask] = impaired_selected

        return impaired_feat, {
            "selected_values": num_values,
            "message_bytes": message_bytes,
            "total_packets": total_packets,
            "budget_packets": budget_packets,
            "sent_packets": sent_packets,
            "received_packets": int(received_packets),
        }

    def forward(
        self,
        message: torch.Tensor,
        record_len: torch.Tensor,
        communication_mask: Optional[torch.Tensor] = None,
        frame_id: Optional[Any] = None,
    ) -> Tuple[torch.Tensor, List[Dict[str, Any]]]:
        if not self.enabled:
            return message, []

        if message is None or record_len is None:
            return message, []

        out = message.clone()
        info_records: List[Dict[str, Any]] = []

        if torch.is_tensor(record_len):
            record_len_list = [int(x) for x in record_len.detach().cpu().tolist()]
        else:
            record_len_list = [int(x) for x in record_len]

        start = 0
        for batch_idx, cav_num in enumerate(record_len_list):
            for local_idx in range(cav_num):
                global_idx = start + local_idx
                if global_idx >= message.shape[0]:
                    continue

                if local_idx == 0 and not self.impair_ego:
                    continue

                link_key = f"b{batch_idx}_cav{local_idx}"
                state = self._next_state(link_key, message.device)
                profile = self.state_profiles[state]

                bandwidth_mbps = float(profile.get("bandwidth_mbps", 0.0))
                packet_loss_rate = float(profile.get("packet_loss_rate", profile.get("plr", 0.0)))

                cur_feat = message[global_idx:global_idx + 1]
                cur_mask = self._normalize_comm_mask(
                    communication_mask,
                    global_idx=global_idx,
                    target_hw=cur_feat.shape[-2:],
                    device=message.device,
                )

                delayed_feat, delayed_mask, delay_slots = self._get_delayed_message(
                    link_key, cur_feat, cur_mask, profile
                )

                impaired_feat, stat = self._apply_packet_budget_and_loss(
                    delayed_feat,
                    delayed_mask,
                    bandwidth_mbps=bandwidth_mbps,
                    packet_loss_rate=packet_loss_rate,
                )

                out[global_idx:global_idx + 1] = impaired_feat

                rec = {
                    "batch_idx": batch_idx,
                    "cav_local_idx": local_idx,
                    "cav_global_idx": global_idx,
                    "link_key": link_key,
                    "state": state,
                    "bandwidth_mbps": bandwidth_mbps,
                    "packet_loss_rate": packet_loss_rate,
                    "delay_ms": float(profile.get("delay_ms", 0.0)),
                    "delay_slots": int(delay_slots),
                    "packet_size_bytes": int(self.packet_size_bytes),
                    "bytes_per_value": int(self.bytes_per_value),
                    "frame_id": str(frame_id) if frame_id is not None else "",
                }
                rec.update(stat)
                info_records.append(rec)

                if self.verbose:
                    print(
                        "[CoSDH-Markov-Byte] "
                        f"link={link_key}, state={state}, bw={bandwidth_mbps:.2f}Mbps, "
                        f"plr={packet_loss_rate:.3f}, delay_slots={delay_slots}, "
                        f"packets recv/sent/total={stat['received_packets']}/"
                        f"{stat['sent_packets']}/{stat['total_packets']}, "
                        f"msg_bytes={stat['message_bytes']}"
                    )

            start += cav_num

        self.last_info = info_records
        return out, info_records
